# Normalize text files to LF in the repository
* text=auto

# Source and configuration
*.java text
*.gradle text
*.properties text
*.json text
*.md text
*.yml text
*.yaml text
*.xml text

# Scripts keep the line endings their interpreter expects
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be converted
*.exe binary
*.dll binary
*.7z binary
*.jar binary
*.zip binary
*.png binary
*.ico binary
*.jpg binary
*.dmp binary
jre/** binary

*.h linguist-detectable=false
